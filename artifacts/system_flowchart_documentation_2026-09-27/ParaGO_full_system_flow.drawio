 parent="1"><mxGeometry x="430" y="2890" width="300" height="130" as="geometry"/></mxCell><mxCell id="0-manualUnload" value="Manual unload confirms the correct ride; GPS is not required for driver fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="1040" y="2910" width="390" height="92" as="geometry"/></mxCell><mxCell id="0-autoUnload" value="Automatic separation completes solo ride only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="260" y="3070" width="350" height="82" as="geometry"/></mxCell><mxCell id="0-rideComplete" value="Complete ride and release occupancy exactly once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="760" y="3070" width="380" height="82" as="geometry"/></mxCell><mxCell id="0-endTripDecision" value="Driver ends trip?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff3d8;strokeColor=#b9791e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="3190" width="280" height="120" as="geometry"/></mxCell><mxCell id="0-continue" value="Keep route operation active for the next booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="1260" y="3210" width="360" height="82" as="geometry"/></mxCell><mxCell id="0-tripEnd" value="End trip explicitly; close residual rides and pending pickups, then notify affected passengers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="760" y="3340" width="430" height="92" as="geometry"/></mxCell><mxCell id="0-processEnd" value="End standard flow" style="shape=terminator;whiteSpace=wrap;html=1;rounded=1;fillColor=#dff1e7;strokeColor=#2f7a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="3445" width="240" height="60" as="geometry"/></mxCell><mxCell id=