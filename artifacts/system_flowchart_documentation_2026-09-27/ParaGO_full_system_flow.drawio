ed" value="Save pending booking with destination and fare snapshot" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e8eef8;strokeColor=#4f6694;" vertex="1" parent="1"><mxGeometry x="760" y="1820" width="380" height="98" as="geometry"/></mxCell><mxCell id="0-cancelExpire" value="Passenger cancels or booking deadline expires; no ride is created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#b14c3a;" vertex="1" parent="1"><mxGeometry x="1250" y="1850" width="380" height="86" as="geometry"/></mxCell><mxCell id="0-bookingClosed" value="Booking closed" style="shape=terminator;whiteSpace=wrap;html=1;rounded=1;fillColor=#dff1e7;strokeColor=#2f7a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="1970" width="210" height="60" as="geometry"/></mxCell><mxCell id="0-notifyAcknowledge" value="Notify assigned driver; driver acknowledges pickup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="760" y="1970" width="380" height="86" as="geometry"/></mxCell><mxCell id="0-ackValid" value="Acknowledged before expiry?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff3d8;strokeColor=#b9791e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="2090" width="280" height="120" as="geometry"/></mxCell><mxCell id="0-ackWait" value="Remain pending until acknowledgement or expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#b14c3a;" vertex="1" parent="1"><mxGeometry x="1260" y="2110" width="360" height="82" as="geometry"/></mxCell><mxCell id="0-boarding" value="Passenger confirms boarding; eligible solo roadside auto-boarding may also complete after dwell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2f5;strokeColor=#2c7285;" vertex="1" parent="1"><mxGeometry x="760" y="2250" width="430" height="92" as="geometry"/></mxCell><mxCell id="0-boardingGps" value="Fresh passenger + jeep GPS and proximity valid?" style="shape=rhombus;whiteSpac