{
  "name": "parago-backend",
  "version": "0.1.0",
  "description": "ParaGO! thesis-oriented backend scaffold (Flutter + Node.js + MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "test:passenger-state": "node --test tests/boarding-notifications.integration.test.js tests/para-push.integration.test.js tests/firebase-admin-config.test.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "route:build": "node scripts/generate_route_payload.js",
    "test": "node test.js && node --test tests/staging-launcher.test.js tests/announcements.integration.test.js tests/realtime-capacity.characterization.test.js tests/phase5-database-migration.test.js tests/redis-foundation.test.js tests/async-worker.test.js tests/worker-process-controls.test.js tests/deployment-hardening.test.js tests/phase10-load-harness.test.js tests/aws-infra-scaffold.test.js tests/driver-license-documents.test.js tests/security-repair.integration.test.js tests/security-counters.test.js tests/auth-email-transport.test.js",
    "test:unit": "node test.js",
    "test:announcements": "node --test tests/announcements.integration.test.js",
    "test:characterization": "node --test tests/realtime-capacity.characterization.test.js",
    "test:staging-guard": "node --test tests/staging-launcher.test.js",
    "phase10:fixtures": "node scripts/prepare-phase10-load-data.js",
    "phase10:profile": "node scripts/configure-phase10-profile.js",
    "phase10:spec": "node scripts/build-phase10-digitalocean-spec.js",
    "phase10:spec:egress-bootstrap": "node scripts/build-phase10-digitalocean-spec.js --egress-bootstrap",
    "phase10:socket": "node load-tests/socket-capacity.js",
    "phase10:socket:dry-run": "node load-tests/socket-capacity.js --dry-run=true",
    "phase10:summary": "node scripts/summarize-phase10-results.js",
    "audit:phase5:production": "node scripts/audit-phase5-database.js --environment=production",
    "audit:phase5:staging": "node scripts/audit-phase5-database.js --environment=staging",
    "audit:phase5:production:forensics": "node scripts/audit-phase5-database.js --environment=production --forensics",
    "migrate:phase5:production:dry-run": "node scripts/migrate-phase5-database.js --environment=production",
    "migrate:phase5:staging:dry-run": "node scripts/migrate-phase5-database.js --environment=staging",
    "test:security": "node --test tests/security-repair.integration.test.js tests/security-counters.test.js tests/auth-email-transport.test.js"
  },
  "keywords": [
    "parago",
    "jeepney",
    "transport",
    "thesis",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.3",
    "redis": "^6.1.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2"
  }
}
